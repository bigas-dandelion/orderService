# Общие
KAFKA_BROKER=localhost:29092
KAFKA_TOPIC=orders

# Consumer
KAFKA_GROUP=order-service-group
HTTP_PORT=8082
CACHE_SIZE=64
DSN=host=localhost user=order_user password=order_pass dbname=orders_db port=5434 sslmode=disable
MIGRATIONS_PATH=file://./db/migrations
POSTGRESQL_URL=postgres://order_user:order_pass@localhost:5434/orders_db?sslmode=disable